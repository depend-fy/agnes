# ===== VeriMind AI 配置模板（阶段 1 锁定版）=====
# 复制本文件为 .env，并填入真实值。切勿把真实密钥提交到 Git。
# .env 已被 .gitignore 忽略。

# ---- 运行模式 ----
# stub = 不调用真实模型（离线跑通闭环）；live = 调用真实 LLM
VERIMIND_MODE=stub

# ---- LLM 端点（均为 OpenAI 兼容协议：/v1/chat/completions + Bearer key）----

# Agnes —— 用于"事实审查员"角色
VERIMIND_AGNESES_BASE_URL=https://api.agnes-ai.cn/v1
VERIMIND_AGNESES_API_KEY=
VERIMIND_AGNESES_MODEL=agnes-3.0-flash

# DeepSeek —— 用于"证据审查员"与"独立复核员"角色（两个角色独立调用，不合并逻辑）
# 注意：模型名以你 DeepSeek 控制台实际可用的为准。报错显示可用型号为
# deepseek-flash / deepseek-v4-pro。默认先用 deepseek-flash（便宜稳定）。
VERIMIND_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VERIMIND_DEEPSEEK_API_KEY=
VERIMIND_DEEPSEEK_MODEL=deepseek-flash

# 单次检测最大 LLM 调用次数（成本控制）
VERIMIND_MAX_LLM_CALLS=30

# 超时（秒）
VERIMIND_LLM_TIMEOUT=60

# ---- 文献检索 ----
# Crossref 建议提供邮箱以遵守其使用条款（可选但推荐）
VERIMIND_CROSSREF_MAILTO=
